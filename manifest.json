{
  "id": "spotify",
  "apiVersion": 1,
  "name": "Spotify",
  "version": "0.2.0",
  "description": "Connect Spotify and control playback on your Spotify Connect devices.",
  "icon": "icon.svg",
  "entry": "main.ts",
  "ui": "ui/index.html",
  "window": { "width": 520, "height": 560 },
  "strictArgs": true,
  "commands": {
    "connect": { "help": "connect a Spotify account", "returns": { "connected": "boolean", "scope": "string?" } },
    "enablePlayback": { "help": "grant the scopes required for playback inside Wonop", "returns": { "connected": "boolean", "scope": "string?" } },
    "enableLibrary": { "help": "request optional Spotify library and playlist access", "returns": { "connected": "boolean", "scope": "string?" } },
    "enableListening": { "help": "request recently played and top listening access", "returns": { "connected": "boolean", "scope": "string?" } },
    "disconnect": { "help": "disconnect the Spotify account", "returns": { "connected": "boolean", "revoked": "boolean" } },
    "status": { "help": "connection and current playback status", "returns": { "connected": "boolean", "redirectUri": "string", "playback": "object?" } },
    "nowPlaying": { "help": "current Spotify playback", "returns": { "playback": "object?" } },
    "devices": { "help": "available Spotify Connect devices", "returns": { "devices": "object[]" } },
    "search": { "help": "search Spotify tracks, albums, artists, and playlists", "args": { "query": "string" }, "returns": { "tracks": "object[]", "albums": "object[]", "artists": "object[]", "playlists": "object[]" } },
    "home": { "help": "load Spotify home listening and playlists", "returns": { "playlists": "object[]", "featured": "object[]", "featuredStatus": "string", "recent": "object[]", "recentStatus": "string", "topTracks": "object[]", "topTracksStatus": "string" } },
    "playlists": { "help": "load the account playlists", "returns": { "playlists": "object[]" } },
    "playlist": { "help": "load a playlist and its tracks", "args": { "id": "string" }, "returns": { "playlist": "object", "tracks": "object[]", "trackCount": "number", "contentsStatus": "string" } },
    "album": { "help": "load an album and its tracks", "args": { "id": "string" }, "returns": { "album": "object" } },
    "artist": { "help": "load an artist and top tracks", "args": { "id": "string" }, "returns": { "artist": "object" } },
    "library": { "help": "load saved albums and tracks", "returns": { "albums": "object[]", "tracks": "object[]" } },
    "queue": { "help": "load the current Spotify queue", "returns": { "currentlyPlaying": "object?", "queue": "object[]" } },
    "runtimeCapabilities": { "help": "embedded playback capabilities reported by the Wonop webview", "returns": { "capabilities": "object?" } },
    "surfaceStatus": { "help": "embedded Spotify player readiness without exposing credentials", "returns": { "surface": "object" } },
    "audioDiagnostics": { "help": "fresh read-only embedded SDK audio diagnostics", "returns": { "diagnostics": "object" } },
    "transfer": { "help": "transfer playback to a Spotify Connect device", "args": { "deviceId": "string", "play": "boolean?" }, "returns": { "ok": "boolean" } },
    "play": { "help": "start or resume playback", "args": { "deviceId": "string?" }, "returns": { "ok": "boolean" } },
    "pause": { "help": "pause playback", "args": { "deviceId": "string?" }, "returns": { "ok": "boolean" } },
    "next": { "help": "skip to the next item", "args": { "deviceId": "string?" }, "returns": { "ok": "boolean" } },
    "previous": { "help": "skip to the previous item", "args": { "deviceId": "string?" }, "returns": { "ok": "boolean" } },
    "volume": { "help": "set playback volume", "args": { "percent": "number", "deviceId": "string?" }, "returns": { "ok": "boolean", "percent": "number" } },
    "seek": { "help": "seek within the current track", "args": { "positionMs": "number", "deviceId": "string?" }, "returns": { "ok": "boolean" } },
    "shuffle": { "help": "toggle Spotify shuffle", "args": { "state": "boolean", "deviceId": "string?" }, "returns": { "ok": "boolean", "state": "boolean" } },
    "repeat": { "help": "set Spotify repeat mode", "args": { "state": "string", "deviceId": "string?" }, "returns": { "ok": "boolean", "state": "string" } }
  },
  "permissions": {
    "http": ["api.spotify.com"],
    "secrets": ["spotify"],
    "mediaSurface": {
      "startUrl": "https://sdk.scdn.co/spotify-player.js",
      "script": "surface/player.js",
      "hosts": [
        "scdn.co",
        "spotify.com",
        "audio-ak-spotify-com.akamaized.net",
        "audio4-ak-spotify-com.akamaized.net",
        "heads-ak-spotify-com.akamaized.net",
        "audio-fa-tls130.spotifycdn.com"
      ],
      "userAgent": "safari",
      "oauth": ["spotify"]
    }
  },
  "oauth": {
    "spotify": {
      "authorizeUrl": "https://accounts.spotify.com/authorize",
      "tokenUrl": "https://accounts.spotify.com/api/token",
      "clientId": "850e7591d02e4a309aa9a723116fd3ed",
      "redirectUri": "http://127.0.0.1:8888/callback",
      "scopes": ["user-read-playback-state", "user-modify-playback-state"],
      "extraScopes": ["streaming", "user-read-email", "user-read-private", "playlist-read-private", "playlist-read-collaborative", "user-library-read", "user-top-read", "user-read-recently-played"],
      "pkce": true
    }
  },
  "palette": [
    { "title": "Open Spotify controls", "snippet": "await wm.app.open(\"spotify\")" },
    { "title": "Spotify playback status", "snippet": "await wm.apps.spotify.status()" }
  ]
}
